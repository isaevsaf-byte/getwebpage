# Anthropic — get from console.anthropic.com
ANTHROPIC_API_KEY=

# Vercel KV — auto-populated when you bind a KV store in Vercel Dashboard > Storage
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Resend — transactional email (contact form, order confirmations, lead alerts)
RESEND_API_KEY=

# Stripe — payments and webhook signature verification
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Ceiling on free audits per day across all callers. Guards the Anthropic bill.
AUDIT_GLOBAL_DAILY_LIMIT=500

# Ceiling on AI tagline drafts per day across all callers (Claude Haiku). Guards the Anthropic bill.
AI_COPY_GLOBAL_DAILY_LIMIT=400

# Set to https://getwebpage.co.uk in production
NEXT_PUBLIC_BASE_URL=https://getwebpage.co.uk

# ── Owner alerts and dashboard ───────────────────────────────────────────────
# Telegram: create a bot with @BotFather, send it any message, then open /admin
# — the dashboard lists your chat id so you can paste it here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# /admin is disabled entirely until ADMIN_PASSWORD is set. Username defaults to "saf".
ADMIN_USER=saf
ADMIN_PASSWORD=

# Vercel Cron sends this as a Bearer token to /api/digest (daily 08:00 UTC).
CRON_SECRET=
